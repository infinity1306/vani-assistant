{
    "system": {
        "sample_rate": 16000,
        "max_recording_seconds": 10,
        "idle_timeout_ms": 1000,
        "performance_profile": "auto"
    },
    "wakeword": {
        "model_path": "models/vani_v1.onnx",
        "threshold": 0.5
    },
    "auth": {
        "threshold": 0.75,
        "embeddings_path": "data/embeddings.enc"
    },
    "stt": {
        "model_size": "tiny",
        "device": "cpu",
        "compute_type": "int8",
        "_note": "Forced to tiny CPU model for maximum speed on low spec PCs."
    },
    "tts": {
        "voice": "en-IN-NeerjaNeural"
    },
    "intent": {
        "primary_provider": "ollama",
        "ollama_url": "http://localhost:11434",
        "router_model": "llama3.2:1b",
        "chat_model": "llama3.2:1b",
        "coder_model": "deepseek-r1:8b",
        "enable_web_search": true,
        "num_ctx": 2048,
        "llm_timeout": 60,
        "temperature": 0.1,
        "num_predict": 256
    },
    "logging": {
        "level": "INFO",
        "log_llm_prompts": false,
        "log_llm_responses": true
    },
    "vision": {
        "camera_index": 0
    },
    "audio": {
        "device_id": null
    }
}